# Шаблон .env для Remnawave Panel.
# Скопировать в .env, заполнить, chmod 600 .env. НЕ КОММИТИТЬ .env.

### Домены ###
# Домен панели (админка). Должен резолвиться на IP сервера панели.
FRONT_END_DOMAIN=panel.example.com

# Домен страницы подписки (её видят сотрудники).
SUB_PUBLIC_DOMAIN=sub.example.com

### Порты ###
APP_PORT=3000
METRICS_PORT=3001

### Секреты (сгенерировать!) ###
# openssl rand -hex 32
APP_SECRET=CHANGE_ME_openssl_rand_hex_32
# ровно 64 символа a-zA-Z0-9
WEBHOOK_SECRET_HEADER=CHANGE_ME_64_chars

### База данных ###
POSTGRES_USER=remnawave
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=remnawave

### Telegram (необязательно, но удобно для уведомлений) ###
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш Telegram ID (узнать: @userinfobot). Несколько — через запятую.
TELEGRAM_ADMIN_IDS=
IS_TELEGRAM_NOTIFICATIONS_ENABLED=false

### Уведомления об окончании подписки ###
EXPIRATION_NOTIFICATIONS_ENABLED=false
EXPIRATION_NOTIFICATIONS=[-72,-24]

### API-токен для страницы подписки ###
# Создать в панели после первого запуска: Settings → API Tokens
REMNAWAVE_API_TOKEN=

### Прочее ###
# Часовой пояс для логов/уведомлений
TZ=Europe/Kaliningrad
